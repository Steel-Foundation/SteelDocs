---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/sections/Navbar.astro";
import ImplementationTracker from "@/components/tracker/ImplementationTracker";
---

<Layout
  title="Implementation Tracker - SteelMC"
  description="Track which Minecraft blocks, items, and entities have behavior implementations in SteelMC."
>
  <Navbar />
  <main
    class="container mx-4 w-auto lg:mx-auto max-w-300 px-4 pt-24 pb-20 relative z-10"
  >
    <div class="mb-8">
      <h1
        class="text-3xl md:text-5xl font-minecraft font-bold text-teal-950 dark:text-white"
      >
        Implementation <span class="text-emerald-600 dark:text-emerald-400"
          >Tracker</span
        >
      </h1>
      <p class="max-w-190 text-lg text-teal-700 dark:text-gray-300 mt-3 md:text-xl">
        Track which Minecraft blocks, items, and entities have behavior
        implementations in Steel.
      </p>
    </div>
    <ImplementationTracker client:only="react" />
  </main>
</Layout>
