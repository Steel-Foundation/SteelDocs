---
import Layout from "@/layouts/Layout.astro";
import ImplementationTracker from "@/components/tracker/ImplementationTracker";

const t = Astro.locals.t;
---

<Layout
  title={t("tracker.metaTitle")}
  description={t("tracker.metaDescription")}
>
  <main
    class="container mx-4 w-auto lg:mx-auto max-w-300 px-4 pt-24 pb-20 relative z-10"
  >
    <div class="mb-8">
      <h1
        class="text-3xl md:text-5xl font-minecraft font-bold text-teal-950 dark:text-white"
      >
        {t("tracker.title")} <span class="text-emerald-600 dark:text-emerald-400"
          >{t("tracker.titleHighlight")}</span
        >
      </h1>
      <!-- Description -->
      <p class="max-w-190 text-lg text-teal-700 dark:text-gray-300 mt-3 md:text-xl">
        {t("tracker.description")} <span class="font-bold text-teal-900 dark:text-teal-100">{t("tracker.note")}</span>
      </p>
    </div>
    <ImplementationTracker client:only="react" />
  </main>
</Layout>
