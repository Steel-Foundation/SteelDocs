---
import Layout from "@/layouts/Layout.astro";
import { Heart } from "@lucide/astro";
import data from "@/data/sponsors.json";

import { t as tBase } from "@/lib/utils";
function t(key: string): string {return tBase(Astro, key)}

// Generated by scripts/sync-sponsors.ts during the CI build.
const { sponsors, updatedAt, goal } = data as {
  goal: {
    kind: "MONTHLY_SPONSORSHIP_AMOUNT" | "TOTAL_SPONSORS_COUNT";
    title: string;
    description: string | null;
    percentComplete: number;
    targetValue: number;
  } | null;
  sponsors: { login: string; name: string; avatarUrl: string; url: string; active: boolean; oneTime: boolean }[];
  updatedAt: string | null;
};
const groups = [
  { title: t("donate.current"), list: sponsors.filter((s) => s.active && !s.oneTime) },
  { title: t("donate.oneTime"), list: sponsors.filter((s) => s.oneTime) },
  { title: t("donate.past"), list: sponsors.filter((s) => !s.active && !s.oneTime) },
].filter((g) => g.list.length);
const goalTarget = goal
  ? t(goal.kind === "MONTHLY_SPONSORSHIP_AMOUNT" ? "donate.goalMonthly" : "donate.goalCount").replace(
      "{{value}}",
      String(goal.targetValue),
    )
  : null;
const updated = updatedAt
  ? new Intl.DateTimeFormat(Astro.currentLocale || "en", { dateStyle: "medium" }).format(new Date(updatedAt))
  : null;

// ponytail: Steel-Foundation sponsor page still awaiting approval, switch when live
const SPONSOR_URL = "https://github.com/sponsors/Steel-Foundation";
---

<Layout title={t("donate.metaTitle")} description={t("donate.metaDescription")}>
  <main class="relative z-10 mx-auto w-full max-w-300 px-4 pb-20 pt-28 sm:px-6 lg:pt-32">
    <header class="mx-auto mb-12 max-w-210 text-center">
      <h1 class="font-minecraft text-4xl font-bold leading-tight text-teal-950 dark:text-white sm:text-5xl md:text-7xl">
        {t("donate.title")} <span class="text-emerald-600 dark:text-emerald-400">{t("donate.titleHighlight")}</span>
      </h1>
      <p class="mx-auto mt-5 max-w-170 text-base leading-relaxed text-teal-700 dark:text-white/60 md:text-xl">
        {t("donate.subtitle")}
      </p>
      <a
        href={SPONSOR_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="button-enamel mt-8 inline-flex items-center gap-2 rounded-[10px] bg-black px-6 py-2.5 font-minecraft text-sm font-bold text-white transition-all hover:-translate-y-px hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-100"
      >
        <Heart class="size-4" />
        {t("donate.cta")}
      </a>
    </header>

    {
      goal && (
        <section aria-labelledby="goal" class="surface-forged mx-auto mb-12 max-w-210 rounded-3xl border border-emerald-500/25 bg-white/85 p-6 shadow-xl shadow-teal-950/8 backdrop-blur-md dark:border-emerald-400/20 dark:bg-teal-950/80 dark:shadow-black/20 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-emerald-700 dark:text-emerald-300">
            {t("donate.goal")}
          </p>
          <h2 id="goal" class="mt-2 font-minecraft text-2xl font-bold text-teal-950 dark:text-white sm:text-3xl">
            {goal.title}
          </h2>
          {goal.description && (
            <p class="mt-2 text-teal-700 dark:text-white/60">{goal.description}</p>
          )}
          <div
            role="progressbar"
            aria-labelledby="goal"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={Math.min(goal.percentComplete, 100)}
            class="mt-5 h-4 overflow-hidden rounded-full bg-teal-100 dark:bg-white/10"
          >
            <div
              class="h-full rounded-full bg-emerald-500 dark:bg-emerald-400"
              style={`width: ${Math.min(goal.percentComplete, 100)}%`}
            />
          </div>
          <p class="mt-2 flex justify-between text-sm font-semibold text-teal-700 dark:text-white/60">
            <span>{goal.percentComplete}%</span>
            <span>{goalTarget}</span>
          </p>
        </section>
      )
    }

    {
      groups.length ? (
        groups.map((g) => (
          <section class="mb-10">
            <h2 class="mb-4 font-minecraft text-2xl font-bold text-teal-950 dark:text-white">{g.title}</h2>
            <ul class="grid grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] gap-3">
              {g.list.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 rounded-2xl border border-teal-200/60 bg-white/85 p-3 text-teal-950 backdrop-blur-md transition-colors hover:border-emerald-500/50 dark:border-white/10 dark:bg-teal-950/80 dark:text-white dark:hover:border-emerald-400/40"
                  >
                    <img
                      src={s.avatarUrl}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                      class="size-10 rounded-lg"
                    />
                    <span class="min-w-0">
                      <span class="block truncate font-minecraft font-bold">{s.name}</span>
                      {s.name !== s.login && (
                        <span class="block truncate text-xs text-teal-600 dark:text-white/45">@{s.login}</span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <p class="text-center text-teal-700 dark:text-white/60">{t("donate.empty")}</p>
      )
    }

    <p class="mt-12 text-center text-sm text-teal-600 dark:text-white/45">
      {t("donate.refreshHint")}
      {updated && <>{" "}{t("donate.lastUpdated")}: <time datetime={updatedAt!}>{updated}</time></>}
    </p>
  </main>
</Layout>
