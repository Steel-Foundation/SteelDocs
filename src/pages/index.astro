---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/sections/Navbar.astro";
import Hero from "@/components/sections/Hero.astro";
import ChooseDocs from "@/components/sections/ChooseDocs.astro";
import Community from "@/components/sections/Community.astro";
import FooterStatus from "@/components/sections/FooterStatus.astro";
import { getDocHref } from "@/lib/docs-href";

const { t } = Astro.locals;
const locale = Astro.currentLocale ?? "en";

const docsCtaHref = await getDocHref("getting-started/introduction", locale);
const adminHref = await getDocHref("getting-started/installation", locale);
const devHref = await getDocHref("development/start-contributing", locale);

const rotatingTexts = [
  t("home.status.rotating.0"),
  t("home.status.rotating.1"),
  t("home.status.rotating.2"),
  t("home.status.rotating.3"),
  t("home.status.rotating.4"),
  t("home.status.rotating.5"),
  t("home.status.rotating.6"),
  t("home.status.rotating.7"),
  t("home.status.rotating.8"),
  t("home.status.rotating.9"),
];
---

<Layout
  title="SteelMC"
  description={t("home.meta.description")}
>
  <Navbar />
  <Hero
    pillText={t("home.hero.pill")}
    heroTitle="Steel"
    heroTitleHighlight="MC"
    subtitle={t("home.hero.subtitle")}
    mainCtaText={t("home.hero.ctaMain")}
    secondCtaText={t("home.hero.ctaDocs")}
    secondCtaHref={docsCtaHref}
  />
  <main
    class="container mx-4 w-auto lg:mx-auto max-w-280 px-4 mt-16 lg:-mt-12 text-white relative z-10"
  >
    <ChooseDocs
      sectionLabel={t("home.chooseDocs.label")}
      sectionTitle={t("home.chooseDocs.title")}
      sectionDescription={t("home.chooseDocs.description")}
      adminHref={adminHref}
      adminImage="/admin.png"
      adminImageAlt={t("home.chooseDocs.adminAlt")}
      adminLabel={t("home.chooseDocs.adminLabel")}
      devHref={devHref}
      devImage="/contributor.png"
      devImageAlt={t("home.chooseDocs.devAlt")}
      devLabel={t("home.chooseDocs.devLabel")}
    />
    <Community
      heading={t("home.community.heading")}
      headingHighlight={t("home.community.headingHighlight")}
      descriptionBold1={t("home.community.bold1")}
      descriptionMiddle={t("home.community.middle")}
      descriptionBold2={t("home.community.bold2")}
      descriptionAfter={t("home.community.after")}
    />
    <FooterStatus
      prefix={t("home.status.prefix")}
      rotatingTexts={rotatingTexts}
    />
  </main>
</Layout>
