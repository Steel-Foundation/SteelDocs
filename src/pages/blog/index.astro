---
import { getCollection } from "astro:content";
import { ArrowRight, CalendarDays, Newspaper } from "@lucide/astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

import { t as tBase } from "@/lib/utils";
function t(key: string): string {return tBase(Astro, key)}

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(Astro.currentLocale ?? "en", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<BlogLayout
  title={t("blog.metaTitle")}
  description={t("blog.metaDescription")}
>
  <main class="relative z-10 mx-auto min-h-screen max-w-280 px-6 pb-24 pt-32">
    <header class="mx-auto mb-10 max-w-210 text-center md:mb-14">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1.5 font-minecraft text-xs font-semibold uppercase tracking-[0.16em] text-emerald-700 dark:border-emerald-400/25 dark:text-emerald-300"
      >
        <Newspaper class="size-3.5" />
        {t("blog.badge")}
      </div>
      <h1
        class="font-minecraft text-4xl font-bold leading-tight text-teal-950 dark:text-white sm:text-5xl md:text-7xl"
      >
        {t("blog.title")} <span class="text-emerald-600 dark:text-emerald-400">{t("blog.titleHighlight")}</span>
      </h1>
      <p class="mx-auto mt-5 max-w-170 text-base leading-relaxed text-teal-700 dark:text-white/60 md:text-xl">
        {t("blog.subtitle")}
      </p>
    </header>

    {
      featuredPost && (
        <section class="mt-10 mx-auto max-w-4xl" aria-labelledby="featured-heading">
          <h2 id="featured-heading" class="sr-only">{t("blog.featured")}</h2>
          <a
            href={getRelativeLocaleUrl(
              Astro.currentLocale || "en",
              `/blog/${featuredPost.id}/`,
            )}
            class="surface-forged group relative block overflow-hidden rounded-3xl border border-emerald-500/25 bg-white/85 p-8 shadow-2xl shadow-teal-950/10 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-emerald-500/50 dark:border-emerald-400/20 dark:bg-teal-950/80 dark:shadow-black/25 sm:p-10"
          >
            <div
              class="pointer-events-none absolute -right-24 -top-32 size-90 rounded-full bg-emerald-400/20 blur-3xl transition-transform duration-500 group-hover:scale-110 dark:bg-emerald-400/15"
            />
            <div
              class="pointer-events-none absolute -bottom-40 -left-20 size-80 rounded-full bg-teal-400/15 blur-3xl transition-transform duration-500 group-hover:scale-110 dark:bg-teal-400/10"
            />
            <div class="relative w-full">
              <div class="mb-5 flex flex-wrap items-center gap-3 text-sm">
                <span class="rounded-full bg-emerald-500 px-3 py-1 font-minecraft text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-emerald-500/20">
                  {t("blog.featured")}
                </span>
                <span class="rounded-full border border-teal-200/80 bg-teal-50/80 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-teal-700 dark:border-white/10 dark:bg-white/5 dark:text-white/60">
                  {featuredPost.data.category}
                </span>
              </div>
              <h2 class="font-minecraft text-3xl font-bold text-teal-950 dark:text-white sm:text-4xl md:text-5xl">
                {featuredPost.data.title}
              </h2>
              <p class="mt-4 text-base leading-relaxed text-teal-700 dark:text-white/65 md:text-lg">
                {featuredPost.data.description}
              </p>
              <div class="mt-8 flex flex-wrap items-center justify-between gap-5 border-t border-teal-200/60 pt-6 dark:border-white/10">
                <span class="flex items-center gap-2 text-sm text-teal-600 dark:text-white/50">
                  <CalendarDays class="size-4" />
                  {formatDate(featuredPost.data.publishedAt)}
                </span>
                <span class="flex items-center gap-2 font-minecraft font-bold text-emerald-700 transition-colors group-hover:text-emerald-600 dark:text-white dark:group-hover:text-emerald-200">
                  <span>{t("blog.readArticle")}</span>
                  <ArrowRight class="size-4 text-emerald-600 transition-transform group-hover:translate-x-1 dark:text-white dark:group-hover:text-emerald-200" />
                </span>
              </div>
            </div>
          </a>
        </section>
      )
    }

    {
      remainingPosts.length > 0 && (
        <section class="mt-16 mx-auto max-w-4xl" aria-labelledby="latest-heading">
          <h2 id="latest-heading" class="font-minecraft text-2xl font-bold text-teal-950 dark:text-white sm:text-3xl">
            {t("blog.latestPosts")}
          </h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {remainingPosts.map((post) => (
              <a
                href={getRelativeLocaleUrl(
                  Astro.currentLocale || "en",
                  `/blog/${post.id}/`,
                )}
                class="surface-forged group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-teal-200/70 bg-white/80 p-7 shadow-lg shadow-teal-950/5 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-emerald-500/50 hover:shadow-xl dark:border-white/10 dark:bg-teal-950/75 dark:shadow-black/15"
              >
                <div>
                  <span class="inline-block rounded-full border border-teal-200/80 bg-teal-50/80 px-3 py-1 font-minecraft text-xs font-bold uppercase tracking-wider text-emerald-700 dark:border-white/10 dark:bg-white/5 dark:text-emerald-400">
                    {post.data.category}
                  </span>
                  <h3 class="mt-4 font-minecraft text-2xl font-bold text-teal-950 transition-colors group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">
                    {post.data.title}
                  </h3>
                  <p class="mt-3 text-base leading-relaxed text-teal-700 dark:text-white/60">
                    {post.data.description}
                  </p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-teal-200/50 pt-4 dark:border-white/10">
                  <span class="flex items-center gap-2 text-sm text-teal-600 dark:text-white/50">
                    <CalendarDays class="size-4" />
                    {formatDate(post.data.publishedAt)}
                  </span>
                  <ArrowRight class="size-4 text-emerald-600 transition-transform group-hover:translate-x-1 dark:text-emerald-400" />
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
</BlogLayout>
