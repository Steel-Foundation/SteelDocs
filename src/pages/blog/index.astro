---
import { getCollection } from "astro:content";
import { ArrowRight, CalendarDays, Newspaper } from "@lucide/astro";
import BlogLayout from "@/layouts/BlogLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<BlogLayout
  title="Blog - SteelMC"
  description="Announcements, development updates, and stories from the SteelMC team."
>
  <main class="relative z-10 mx-auto min-h-screen max-w-280 px-6 pb-24 pt-32">
    <header class="max-w-3xl">
      <div
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-600/20 bg-emerald-500/10 px-3 py-1.5 font-minecraft text-xs font-bold uppercase tracking-widest text-emerald-700 dark:border-emerald-400/25 dark:text-emerald-300"
      >
        <Newspaper class="size-3.5" />
        From the workshop
      </div>
      <h1
        class="font-minecraft text-5xl font-bold leading-none text-teal-950 dark:text-white md:text-7xl"
      >
        SteelMC <span class="text-emerald-600 dark:text-emerald-400">Blog</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-teal-700 dark:text-white/65">
        Announcements, technical deep dives, and progress updates from the
        people building SteelMC.
      </p>
    </header>

    {
      featuredPost && (
        <section class="mt-14" aria-labelledby="featured-heading">
          <h2 id="featured-heading" class="sr-only">Featured post</h2>
          <a
            href={`/blog/${featuredPost.id}/`}
            class="group relative block overflow-hidden rounded-3xl border border-teal-200/80 bg-white/80 p-7 shadow-2xl shadow-teal-950/10 backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-emerald-500/40 dark:border-white/10 dark:bg-teal-950/75 dark:shadow-black/20 md:p-10"
          >
            <div
              class="pointer-events-none absolute -right-24 -top-32 size-80 rounded-full bg-emerald-400/20 blur-3xl transition-transform duration-500 group-hover:scale-110 dark:bg-emerald-400/15"
            />
            <div class="relative max-w-3xl">
              <div class="mb-8 flex flex-wrap items-center gap-3 text-sm">
                <span class="rounded-full bg-emerald-600 px-3 py-1 font-minecraft font-bold text-white">
                  Featured
                </span>
                <span class="text-teal-600 dark:text-white/55">
                  {featuredPost.data.category}
                </span>
              </div>
              <h2 class="font-minecraft text-3xl font-bold text-teal-950 dark:text-white md:text-5xl">
                {featuredPost.data.title}
              </h2>
              <p class="mt-4 max-w-2xl text-base leading-7 text-teal-700 dark:text-white/65 md:text-lg">
                {featuredPost.data.description}
              </p>
              <div class="mt-8 flex flex-wrap items-center justify-between gap-5">
                <span class="flex items-center gap-2 text-sm text-teal-600 dark:text-white/50">
                  <CalendarDays class="size-4" />
                  {formatDate(featuredPost.data.publishedAt)}
                </span>
                <span class="flex items-center gap-2 font-minecraft font-bold text-emerald-700 dark:text-emerald-400">
                  Read article
                  <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </div>
          </a>
        </section>
      )
    }

    {
      remainingPosts.length > 0 && (
        <section class="mt-16" aria-labelledby="latest-heading">
          <h2 id="latest-heading" class="font-minecraft text-2xl font-bold text-teal-950 dark:text-white">
            Latest posts
          </h2>
          <div class="mt-6 grid gap-5 md:grid-cols-2">
            {remainingPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group rounded-2xl border border-teal-200/80 bg-white/75 p-6 backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-emerald-500/40 dark:border-white/10 dark:bg-teal-950/70"
              >
                <span class="font-minecraft text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
                  {post.data.category}
                </span>
                <h3 class="mt-3 font-minecraft text-2xl font-bold text-teal-950 dark:text-white">
                  {post.data.title}
                </h3>
                <p class="mt-3 leading-7 text-teal-700 dark:text-white/60">
                  {post.data.description}
                </p>
                <span class="mt-6 flex items-center gap-2 text-sm text-teal-600 dark:text-white/50">
                  <CalendarDays class="size-4" />
                  {formatDate(post.data.publishedAt)}
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
</BlogLayout>
