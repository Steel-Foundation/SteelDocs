---

<figure
  class="tick-architecture"
  data-tick-architecture
  aria-labelledby="tick-architecture-title"
>
  <div class="tick-architecture__glow" aria-hidden="true"></div>

  <header class="tick-architecture__header">
    <div>
      <p class="tick-architecture__kicker">Steel's runtime architecture</p>
      <h3 id="tick-architecture-title">Continuous work, one safe boundary</h3>
    </div>

    <button
      class="tick-architecture__play"
      type="button"
      data-animation-toggle
      data-paused="true"
      aria-pressed="true"
      aria-label="Play timeline animation"
    >
      <svg class="tick-architecture__pause-icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 3.25h2.5v9.5H4zm5.5 0H12v9.5H9.5z"></path>
      </svg>
      <svg class="tick-architecture__play-icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="m4.75 2.75 8 5.25-8 5.25z"></path>
      </svg>
      <span data-animation-label>Play</span>
    </button>
  </header>

  <div class="tick-architecture__scenario-picker" aria-label="Timeline scenario">
    {
      scenarios.map((scenario, index) => (
        <button
          type="button"
          data-scenario-button={scenario.id}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {scenario.label}
        </button>
      ))
    }
  </div>

  {
    scenarios.map((scenario, index) => (
      <section
        class="tick-architecture__scenario"
        data-scenario={scenario.id}
        hidden={index !== 0}
        aria-hidden={index === 0 ? "false" : "true"}
      >
        <div class="tick-architecture__axis" aria-hidden="true">
          <span>Tick N</span>
          <span>+50 ms</span>
          <span>+100 ms</span>
        </div>

        <div class="tick-architecture__lanes">
          <div class="tick-architecture__boundaries" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <span class="tick-architecture__playhead"></span>
          </div>

          {scenario.lanes.map((lane) => (
            <div class="tick-architecture__lane">
              <div class="tick-architecture__lane-label">
                <strong>{lane.name}</strong>
                <span class="tick-architecture__lane-phases">
                  {
                    lane.phases.map((phase) => (
                      <span
                        class={`tick-architecture__lane-phase tick-architecture__lane-phase--${phase.kind}`}
                      >
                        {phase.label}
                      </span>
                    ))
                  }
                </span>
              </div>
              <div class="tick-architecture__track">
                {lane.events.map((event) => (
                  <div
                    class={`tick-architecture__event tick-architecture__event--${event.kind}`}
                    style={`--event-left: ${event.start}%; --event-end: ${event.end}%;`}
                    data-timeline-event
                    data-start={event.start}
                    data-end={event.end}
                    title={event.detail ? `${event.label}: ${event.detail}` : event.label}
                  >
                    <span class="tick-architecture__event-label">{event.label}</span>
                    {event.detail && (
                      <span class="tick-architecture__event-detail">{event.detail}</span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div
          class:list={[
            "tick-architecture__explanation",
            `tick-architecture__explanation--${scenario.tone}`,
          ]}
        >
          <span class="tick-architecture__status-dot" aria-hidden="true"></span>
          <div>
            <p>{scenario.eyebrow}</p>
            <strong>{scenario.title}</strong>
            <span>{scenario.description}</span>
          </div>
        </div>
      </section>
    ))
  }

  <figcaption>
    Conceptual timing, expanded for clarity rather than measured to scale. Chunk
    sending validates the player send epoch, holder identity, ticking-readiness
    generation, and packet-content revision before committing a packet.
  </figcaption>
</figure>

<script>
  const initialiseTickArchitecture = (figure: HTMLElement) => {
    if (figure.dataset.initialised === "true") return;
    figure.dataset.initialised = "true";

    const scenarioButtons = Array.from(
      figure.querySelectorAll<HTMLButtonElement>("[data-scenario-button]"),
    );
    const scenarios = Array.from(
      figure.querySelectorAll<HTMLElement>("[data-scenario]"),
    );
    const animationToggle =
      figure.querySelector<HTMLButtonElement>("[data-animation-toggle]");
    const animationLabel =
      figure.querySelector<HTMLElement>("[data-animation-label]");

    if (!animationToggle || !animationLabel || scenarios.length === 0) return;

    const cycleDuration = 8_000;
    let activeScenario = scenarios[0];
    let running = false;
    let elapsed = 0;
    let previousFrame = performance.now();
    let animationFrame = 0;

    const setToggleState = () => {
      animationToggle.dataset.paused = running ? "false" : "true";
      animationToggle.setAttribute("aria-pressed", running ? "false" : "true");
      animationToggle.setAttribute(
        "aria-label",
        running ? "Pause timeline animation" : "Play timeline animation",
      );
      animationLabel.textContent = running ? "Pause" : "Play";
    };

    const render = () => {
      const progress = elapsed / cycleDuration;
      activeScenario.style.setProperty("--playhead-position", `${progress * 100}%`);

      activeScenario
        .querySelectorAll<HTMLElement>("[data-timeline-event]")
        .forEach((event) => {
          const start = Number(event.dataset.start) / 100;
          const end = Number(event.dataset.end) / 100;
          let eventProgress = 0;
          let state = "upcoming";

          if (progress >= end) {
            eventProgress = 1;
            state = "past";
          } else if (progress >= start) {
            eventProgress = (progress - start) / (end - start);
            state = "active";
          }

          event.dataset.state = state;
          event.style.setProperty(
            "--event-progress",
            `${Math.max(0, Math.min(1, eventProgress)) * 100}%`,
          );
        });
    };

    const animate = (now: number) => {
      if (!figure.isConnected) return;
      if (running) {
        elapsed = (elapsed + now - previousFrame) % cycleDuration;
        render();
      }
      previousFrame = now;
      animationFrame = requestAnimationFrame(animate);
    };

    const selectScenario = (id: string) => {
      const nextScenario = scenarios.find(
        (scenario) => scenario.dataset.scenario === id,
      );
      if (!nextScenario) return;

      activeScenario = nextScenario;
      elapsed = 0;
      previousFrame = performance.now();

      scenarios.forEach((scenario) => {
        const active = scenario === nextScenario;
        scenario.hidden = !active;
        scenario.setAttribute("aria-hidden", active ? "false" : "true");
      });
      scenarioButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          button.dataset.scenarioButton === id ? "true" : "false",
        );
      });
      render();
    };

    scenarioButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.scenarioButton;
        if (id) selectScenario(id);
      });
    });

    animationToggle.addEventListener("click", () => {
      running = !running;
      previousFrame = performance.now();
      setToggleState();
      render();
    });

    setToggleState();
    render();
    animationFrame = requestAnimationFrame(animate);

    window.addEventListener(
      "pagehide",
      () => cancelAnimationFrame(animationFrame),
      { once: true },
    );
  };

  document
    .querySelectorAll<HTMLElement>("[data-tick-architecture]")
    .forEach(initialiseTickArchitecture);
</script>

<style>
  .tick-architecture {
    --tick-heading: rgb(4 47 46);
    --tick-text: rgb(17 94 89);
    --tick-muted: rgb(15 118 110 / 0.72);
    --tick-faint: rgb(15 118 110 / 0.56);
    --tick-border: rgb(13 148 136 / 0.2);
    --tick-grid: rgb(13 148 136 / 0.08);
    --tick-surface: rgb(255 255 255 / 0.3);
    --tick-surface-strong: rgb(255 255 255 / 0.48);

    position: relative;
    isolation: isolate;
    margin-block: 2.75rem;
    border-block: 1px solid var(--tick-border);
    padding-block: 1.5rem 1.25rem;
    color: var(--tick-text);
  }

  :global(.dark) .tick-architecture {
    --tick-heading: rgb(255 255 255 / 0.94);
    --tick-text: rgb(204 251 241 / 0.82);
    --tick-muted: rgb(204 251 241 / 0.56);
    --tick-faint: rgb(204 251 241 / 0.42);
    --tick-border: rgb(94 234 212 / 0.16);
    --tick-grid: rgb(255 255 255 / 0.035);
    --tick-surface: rgb(1 28 32 / 0.2);
    --tick-surface-strong: rgb(255 255 255 / 0.04);
  }

  .tick-architecture__glow {
    display: none;
  }

  .tick-architecture__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .tick-architecture__kicker {
    margin: 0 0 0.3rem;
    color: rgb(45 212 191);
    font-family: "Minecraft", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .tick-architecture h3 {
    margin: 0;
    color: var(--tick-heading);
    font-family: "Minecraft", sans-serif;
    font-size: clamp(1.2rem, 3vw, 1.65rem);
    line-height: 1.2;
  }

  .tick-architecture__play {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.38rem;
    min-height: 2rem;
    border: 1px solid var(--tick-border);
    border-radius: 0;
    padding: 0.4rem 0.7rem;
    background: var(--tick-surface-strong);
    color: var(--tick-text);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  .tick-architecture__play:hover {
    border-color: rgb(94 234 212 / 0.4);
    background: rgb(45 212 191 / 0.1);
  }

  .tick-architecture__play:focus-visible,
  .tick-architecture__scenario-picker button:focus-visible {
    outline: 2px solid rgb(94 234 212);
    outline-offset: 2px;
  }

  .tick-architecture__play svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: currentcolor;
  }

  .tick-architecture__play-icon,
  .tick-architecture__play[data-paused="true"] .tick-architecture__pause-icon {
    display: none;
  }

  .tick-architecture__play[data-paused="true"] .tick-architecture__play-icon {
    display: block;
  }

  .tick-architecture__scenario-picker {
    display: inline-flex;
    gap: 0.25rem;
    margin-top: 1rem;
    border: 1px solid var(--tick-border);
    border-radius: 0;
    padding: 0.25rem;
    background: var(--tick-surface);
  }

  .tick-architecture__scenario-picker button {
    border: 0;
    border-radius: 0;
    padding: 0.48rem 0.72rem;
    background: transparent;
    color: var(--tick-muted);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.1;
    cursor: pointer;
  }

  .tick-architecture__scenario-picker button:hover {
    color: var(--tick-heading);
  }

  .tick-architecture__scenario-picker button[aria-pressed="true"] {
    background: rgb(13 148 136 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(94 234 212 / 0.14);
    color: var(--tick-heading);
  }

  .tick-architecture__scenario[hidden] {
    display: none;
  }

  .tick-architecture__axis {
    position: relative;
    height: 1.4rem;
    margin: 1rem 0 0.15rem 8.3rem;
    color: var(--tick-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
  }

  .tick-architecture__axis span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
  }

  .tick-architecture__axis span:first-child {
    left: 0;
    transform: none;
  }

  .tick-architecture__axis span:nth-child(2) {
    left: 41.67%;
  }

  .tick-architecture__axis span:last-child {
    left: 83.33%;
  }

  .tick-architecture__lanes {
    position: relative;
    display: grid;
    gap: 0.65rem;
  }

  .tick-architecture__boundaries {
    position: absolute;
    z-index: 3;
    top: 0;
    right: 0;
    bottom: 0;
    left: 8.3rem;
    pointer-events: none;
  }

  .tick-architecture__boundaries i {
    position: absolute;
    top: -0.3rem;
    bottom: -0.3rem;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--tick-border) 10%,
      var(--tick-border) 90%,
      transparent
    );
  }

  .tick-architecture__boundaries i:first-child {
    left: 0;
  }

  .tick-architecture__boundaries i:nth-child(2) {
    left: 41.67%;
  }

  .tick-architecture__boundaries i:nth-child(3) {
    left: 83.33%;
  }

  .tick-architecture__playhead {
    position: absolute;
    top: -0.45rem;
    bottom: -0.45rem;
    left: var(--playhead-position, 0%);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(153 246 228) 12%,
      rgb(153 246 228) 88%,
      transparent
