---
type EventKind =
  | "packets"
  | "closed"
  | "boundary"
  | "game"
  | "scheduler"
  | "ready"
  | "encode"
  | "verify"
  | "send"
  | "skip";

interface TimelineEvent {
  label: string;
  detail?: string;
  start: number;
  end: number;
  kind: EventKind;
}

interface Lane {
  name: string;
  note: string;
  events: TimelineEvent[];
}

interface Scenario {
  id: string;
  label: string;
  eyebrow: string;
  title: string;
  description: string;
  tone: "safe" | "warning";
  lanes: Lane[];
}

const packetCadence: TimelineEvent[] = [
  { label: "Drain + close", start: 0, end: 5.3, kind: "closed" },
  { label: "Packets flow continuously", start: 5.3, end: 41.5, kind: "packets" },
  { label: "Drain + close", start: 41.7, end: 47, kind: "closed" },
  { label: "Packets flow continuously", start: 47, end: 83.1, kind: "packets" },
  { label: "Drain + close", start: 83.3, end: 88.6, kind: "closed" },
  { label: "Packets flow continuously", start: 88.6, end: 100, kind: "packets" },
];

const gameCadence: TimelineEvent[] = [
  { label: "Handoff", start: 0, end: 1.3, kind: "boundary" },
  { label: "Game logic", start: 1.3, end: 5.3, kind: "game" },
  { label: "Commit + handoff", start: 41.7, end: 43, kind: "boundary" },
  { label: "Game logic", start: 43, end: 47, kind: "game" },
  { label: "Commit + handoff", start: 83.3, end: 84.6, kind: "boundary" },
  { label: "Game logic", start: 84.6, end: 88.6, kind: "game" },
];

const healthyScheduler: TimelineEvent[] = [
  {
    label: "Epoch A",
    detail: "running",
    start: 1.2,
    end: 10.5,
    kind: "scheduler",
