  { label: "Ready", start: 10.5, end: 41.5, kind: "ready" },
  {
    label: "Epoch B",
    detail: "running",
    start: 42.9,
    end: 52.2,
    kind: "scheduler",
  },
  { label: "Ready", start: 52.2, end: 83.1, kind: "ready" },
  {
    label: "Epoch C",
    detail: "running",
    start: 84.5,
