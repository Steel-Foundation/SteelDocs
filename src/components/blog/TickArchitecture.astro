---
type EventKind =
  | "packets"
  | "closed"
  | "boundary"
  | "game"
  | "scheduler"
  | "ready"
  | "encode"
  | "verify"
  | "send"
  | "skip";

interface TimelineEvent {
  label: string;
  detail?: string;
  start: number;
  end: number;
  kind: EventKind;
}

interface Lane {
  name: string;
  phases: { label: string; kind: EventKind }[];
  events: TimelineEvent[];
}

interface Scenario {
  id: string;
  label: string;
  eyebrow: string;
  title: string;
  description: string;
  tone: "safe" | "warning";
  lanes: Lane[];
}

const packetPhases: Lane["phases"] = [
  { label: "drain + close", kind: "closed" },
  { label: "process packets", kind: "packets" },
];

const gamePhases: Lane["phases"] = [
  { label: "handoff", kind: "boundary" },
  { label: "game logic", kind: "game" },
];

const schedulerPhases: Lane["phases"] = [
  { label: "run epoch", kind: "scheduler" },
  { label: "ready", kind: "ready" },
];

const senderPhases: Lane["phases"] = [
  { label: "snapshot", kind: "boundary" },
  { label: "encode", kind: "encode" },
  { label: "verify", kind: "verify" },
  { label: "send", kind: "send" },
];

const packetCadence: TimelineEvent[] = [
  { label: "Drain + close", start: 0, end: 5.3, kind: "closed" },
  { label: "Packets flow continuously", start: 5.3, end: 41.5, kind: "packets" },
  { label: "Drain + close", start: 41.7, end: 47, kind: "closed" },
  { label: "Packets flow continuously", start: 47, end: 83.1, kind: "packets" },
  { label: "Drain + close", start: 83.3, end: 88.6, kind: "closed" },
  { label: "Packets flow continuously", start: 88.6, end: 100, kind: "packets" },
];

const gameCadence: TimelineEvent[] = [
