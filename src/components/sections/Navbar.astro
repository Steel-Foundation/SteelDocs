---
import {
  Search,
  Sun,
  Moon,
  ChevronDown,
  Globe,
  ChartNoAxesCombined,
  Download,
  Newspaper,
} from "@lucide/astro";
import { i18n } from "astro:config/client";
import { toCodes, getRelativeLocaleUrl } from "astro:i18n";

const supportedLocales = toCodes(i18n!.locales);

interface Props {
  showLanguageSwitcher?: boolean;
}

import { t as tBase } from "@/lib/utils";
function t(key: string): string {return tBase(Astro, key)}

const { showLanguageSwitcher = true } = Astro.props;
const navbarCopy = Object.fromEntries(
  supportedLocales.map((locale) => [
    locale,
    {
      code: locale.toUpperCase(),
      search: Astro.locals.t("header.searchPlaceholder", { lng: locale }),
      language: Astro.locals.t("languageSelect.accessibleLabel", { lng: locale }),
      blog: Astro.locals.t("header.blog", { lng: locale }),
      download: Astro.locals.t("header.download", { lng: locale }),
      tracker: Astro.locals.t("header.tracker", { lng: locale }),
      trackerLabel: Astro.locals.t("header.trackerLabel", { lng: locale }),
      noResults: Astro.locals.t("pagefind.zero_results", { lng: locale }),
      devWarning: Astro.locals.t("header.devWarningText", { lng: locale }),
    },
  ]),
);
---

<header
  class="fixed top-0 left-0 right-0 z-50 px-2 pt-2 max-w-280 mx-auto"
  transition:name="main-navbar"
  transition:persist
  transition:animate="none"
  data-navbar-persist
  data-navbar-copy={JSON.stringify(navbarCopy)}
>
  <nav
    class="surface-smoked flex items-center gap-3 px-4 py-2.5 rounded-2xl backdrop-blur-md bg-white/80 dark:bg-teal-950/70 border border-teal-200/60 dark:border-white/10 shadow-xl"
  >
    <!-- Logo -->
    <a
      href={Astro.currentLocale
        ? getRelativeLocaleUrl(Astro.currentLocale, "/")
        : "/"}
      data-localized-path="/"
      class="flex items-center gap-2 font-minecraft font-bold text-xl text-teal-950 dark:text-white shrink-0 mr-2"
      aria-label="SteelMC home"
    >
      <img
        src="/steel_logo.png"
        alt=""
        width="320"
        height="320"
        class="size-9 object-contain [image-rendering:pixelated]"
      />
      <span class="hidden sm:inline"
        >Steel<span class="text-emerald-600 dark:text-emerald-400">MC</span></span
      >
    </a>

    <!-- Search Bar -->
    <form
      id="search-form"
      class="relative flex-1 max-w-60 hidden md:flex"
    >
      <Search
        class="absolute left-3 top-1/2 -translate-y-1/2 size-3.5 text-teal-500 dark:text-white/40 pointer-events-none z-10"
      />
      <input
        id="navbar-search"
        type="search"
        placeholder={t("header.searchPlaceholder")}
        autocomplete="off"
        class="w-full pl-8 pr-3 py-1.5 text-sm bg-teal-100 dark:bg-white/8 border border-teal-300 dark:border-white/15 rounded-2xl text-teal-950 dark:text-white placeholder:text-teal-400 dark:placeholder:text-white/35 focus:outline-none focus:border-emerald-500/60 dark:focus:border-emerald-400/50 transition-all"
      />
      <!-- Results dropdown -->
      <div
        id="search-results"
        class="surface-smoked absolute top-full left-0 right-0 mt-1.5 rounded-2xl bg-white/80 dark:bg-teal-950/80 backdrop-blur-xl border border-teal-200/60 dark:border-white/10 shadow-2xl hidden overflow-hidden"
        role="listbox"
      >
        <div id="search-results-list"></div>
        <p
          id="search-no-results"
          data-search-message="noResults"
          class="hidden px-4 py-3 text-sm text-teal-500 dark:text-white/50"
        >
          {Astro.locals.t("pagefind.zero_results")}
        </p>
        <p
          id="search-dev-warning"
          data-search-message="devWarning"
          class="hidden px-4 py-3 text-sm text-teal-500 dark:text-white/50"
        >
          {t("header.devWarningText")}
        </p>
      </div>
    </form>

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- Actions -->
    <div class="flex items-center gap-1">
      <!-- Blog -->
      <a
        href={getRelativeLocaleUrl(Astro.currentLocale || "en", "/blog")}
        data-localized-path="/blog/"
        data-navbar-link="blog"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-sm text-teal-600 dark:text-white/60 hover:text-teal-950 dark:hover:text-white hover:bg-teal-100 dark:hover:bg-white/10 transition-all"
        aria-label={t("header.blog")}
      >
        <Newspaper class="size-3.5 shrink-0" />
        <span class="hidden font-minecraft lg:inline" data-navbar-label="blog">{t("header.blog")}</span>
      </a>
      <!-- Download -->
      <a
        href={getRelativeLocaleUrl(Astro.currentLocale || "en", "/download")}
        data-localized-path="/download/"
        data-navbar-link="download"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-sm text-teal-600 dark:text-white/60 hover:text-teal-950 dark:hover:text-white hover:bg-teal-100 dark:hover:bg-white/10 transition-all"
        aria-label={t("header.download")}
      >
        <Download class="size-3.5 shrink-0" />
        <span class="hidden font-minecraft sm:inline" data-navbar-label="download"
          >{t("header.download")}</span
        >
      </a>
      <!-- Tracker -->
      <a
        href={getRelativeLocaleUrl(Astro.currentLocale || "en", "/tracker")}
        data-localized-path="/tracker/"
        data-navbar-link="tracker"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-sm text-teal-600 dark:text-white/60 hover:text-teal-950 dark:hover:text-white hover:bg-teal-100 dark:hover:bg-white/10 transition-all"
        aria-label={t("header.trackerLabel")}
      >
        <ChartNoAxesCombined class="size-3.5 shrink-0" />
        <span class="hidden font-minecraft sm:inline" data-navbar-label="tracker"
          >{t("header.tracker")}</span
        >
      </a>

      <!-- Language Switcher -->
      {
        showLanguageSwitcher && supportedLocales.length > 1 && (
          <div class="relative" id="lang-dropdown">
            <button
              id="lang-btn"
              class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-sm text-teal-600 dark:text-white/60 hover:text-teal-950 dark:hover:text-white hover:bg-teal-100 dark:hover:bg-white/10 transition-all cursor-pointer"
              aria-label={Astro.locals.t("languageSelect.accessibleLabel")}
              aria-expanded="false"
              aria-haspopup="true"
            >
              <Globe class="size-3.5 shrink-0" />
              <span class="hidden font-minecraft sm:inline" id="lang-label">
                {Astro.currentLocale?.toUpperCase()}
              </span>
              <ChevronDown class="size-3 transition-transform" id="lang-chevron" />
            </button>
            <div
              id="lang-menu"
              role="menu"
              class="lang-menu surface-smoked absolute right-0 top-full mt-1.5 w-36 rounded-2xl bg-white/80 dark:bg-teal-950/80 backdrop-blur-xl border border-teal-200/60 dark:border-white/10 shadow-2xl overflow-hidden"
            >
              {
                supportedLocales.map((locale, i) => {
                  const currentPath = Astro.url.pathname;
                  const pathWithoutLocale =
                    Astro.currentLocale && Astro.currentLocale !== "en"
                      ? currentPath.replace(
                          new RegExp(`^/${Astro.currentLocale}(/|$)`),
                          "/",
                        )
                      : currentPath;
                  return (
                    <a
                      href={getRelativeLocaleUrl(locale, pathWithoutLocale)}
                      data-language-option={locale}
                      role="menuitem"
                      class:list={[
                        "flex font-minecraft items-center gap-2.5 px-3 py-2 text-sm text-teal-700 dark:text-white/70 hover:text-teal-950 dark:hover:text-white hover:bg-teal-50 dark:hover:bg-white/10 transition-colors",
                        i === 0 && "rounded-t-xl",
                        i === supportedLocales.length - 1 && "rounded-b-xl",
                      ]}
                    >
                      <span aria-hidden="true">
                        {Astro.locals.t("langFlag", "🇬🇧", { lng: locale })}
                      </span>
                      {Astro.locals.t("langName", "English", { lng: locale })}
                    </a>
                  );
                })
              }
            </div>
          </div>
        )
      }

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="p-1.5 rounded-xl text-teal-600 dark:text-white/60 hover:text-teal-950 dark:hover:text-white hover:bg-teal-100 dark:hover:bg-white/10 transition-all cursor-pointer"
        aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
      >
        <div class="relative size-4">
          <Sun class="absolute inset-0 size-full transition-all duration-300 dark:-rotate-90 dark:scale-0" id="sun-icon" />
          <Moon class="absolute inset-0 size-full transition-all duration-300 rotate-90 scale-0 dark:rotate-0 dark:scale-100" id="moon-icon" />
        </div>
      </button>

      <!-- Discord -->
      <a
        href="/discord"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex p-1.5 rounded-xl text-teal-600 dark:text-white/60 hover:text-teal-950 dark:hover:text-white hover:bg-teal-100 dark:hover:bg-white/10 transition-all"
        aria-label={t("header.discordLabel")}
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.04.02.082.042.104a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
          ></path>
        </svg>
      </a>

      <!-- GitHub -->
      <a
        href={Astro.locals.t("githubHref")}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex p-1.5 rounded-xl text-teal-600 dark:text-white/60 hover:text-teal-950 dark:hover:text-white hover:bg-teal-100 dark:hover:bg-white/10 transition-all"
        aria-label={t("header.githubLabel")}
      >
          <svg
            class="size-4"
            viewBox="0 0 98 96"
            fill="currentColor"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M41.4395 69.3848C28.8066 67.8535 19.9062 58.7617 19.9062 46.9902C19.9062 42.2051 21.6289 37.0371 24.5 33.5918C23.2559 30.4336 23.4473 23.7344 24.8828 20.959C28.7109 20.4805 33.8789 22.4902 36.9414 25.2656C40.5781 24.1172 44.4062 23.543 49.0957 23.543C53.7852 23.543 57.6133 24.1172 61.0586 25.1699C64.0254 22.4902 69.2891 20.4805 73.1172 20.959C74.457 23.543 74.6484 30.2422 73.4043 33.4961C76.4668 37.1328 78.0937 42.0137 78.0937 46.9902C78.0937 58.7617 69.1934 67.6621 56.3691 69.2891C59.623 71.3945 61.8242 75.9883 61.8242 81.252L61.8242 91.2051C61.8242 94.0762 64.2168 95.7031 67.0879 94.5547C84.4102 87.9512 98 70.6289 98 49.1914C98 22.1074 75.9883 6.69539e-07 48.9043 4.309e-07C21.8203 1.92261e-07 -1.9479e-07 22.1074 -4.3343e-07 49.1914C-6.20631e-07 70.4375 13.4941 88.0469 31.6777 94.6504C34.2617 95.6074 36.75 93.8848 36.75 91.3008L36.75 83.6445C35.4102 84.2188 33.6875 84.6016 32.1562 84.6016C25.8398 84.6016 22.1074 81.1563 19.4277 74.7441C18.375 72.1602 17.2266 70.6289 15.0254 70.3418C13.877 70.2461 13.4941 69.7676 13.4941 69.1934C13.4941 68.0449 15.4082 67.1836 17.3223 67.1836C20.0977 67.1836 22.4902 68.9063 24.9785 72.4473C26.8926 75.2227 28.9023 76.4668 31.2949 76.4668C33.6875 76.4668 35.2187 75.6055 37.4199 73.4043C39.0469 71.7773 40.291 70.3418 41.4395 69.3848Z"/>
          </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  const navbar = document.querySelector<HTMLElement>("[data-navbar-persist]");
  const navbarCopy = JSON.parse(navbar?.dataset.navbarCopy ?? "{}");

  function currentLocaleCode() {
    const language = document.documentElement.lang.toLowerCase();
    return language.startsWith("de") ? "de" : language.startsWith("es") ? "es" : "en";
  }

  function syncPersistentNavbarLocale() {
    const locale = currentLocaleCode();
    const copy = navbarCopy[locale] ?? navbarCopy.en;
    if (!copy) return;
    const prefix = locale === "en" ? "" : `/${locale}`;

    const label = document.getElementById("lang-label");
    if (label) label.textContent = copy.code;

    const languageButton = document.getElementById("lang-btn");
    languageButton?.setAttribute("aria-label", copy.language);

    const searchInput = document.getElementById("navbar-search");
    searchInput?.setAttribute("placeholder", copy.search);
    document.querySelector<HTMLElement>("[data-search-message=\"noResults\"]")!.textContent = copy.noResults;
    document.querySelector<HTMLElement>("[data-search-message=\"devWarning\"]")!.textContent = copy.devWarning;

    (["blog", "download", "tracker"] as const).forEach((key) => {
      const link = document.querySelector<HTMLElement>(`[data-navbar-link="${key}"]`);
      const text = document.querySelector<HTMLElement>(`[data-navbar-label="${key}"]`);
      if (text) text.textContent = copy[key];
      if (link) link.setAttribute("aria-label", key === "tracker" ? copy.trackerLabel : copy[key]);
    });

    document.querySelectorAll<HTMLAnchorElement>("[data-localized-path]").forEach((link) => {
      link.href = `${prefix}${link.dataset.localizedPath}`;
    });

    const pathWithoutLocale = locale === "en"
      ? window.location.pathname
      : window.location.pathname.replace(new RegExp(`^/${locale}(/|$)`), "/");
    document.querySelectorAll<HTMLAnchorElement>("[data-language-option]").forEach((link) => {
      const optionLocale = link.dataset.languageOption;
      const isDefaultLocale = optionLocale === "root" || optionLocale === "en";
      link.href = isDefaultLocale ? pathWithoutLocale : `/${optionLocale}${pathWithoutLocale}`;
    });
  }

  function initNavbar() {
  if (!navbar || navbar.dataset.initialized === "true") return;
  navbar.dataset.initialized = "true";

  // --- Language dropdown ---
  const langBtn = document.getElementById("lang-btn");
  const langMenu = document.getElementById("lang-menu");
  const langChevron = document.getElementById("lang-chevron");

  function closeLang() {
    langMenu?.classList.remove("is-open");
    langChevron?.classList.remove("rotate-180");
    langBtn?.setAttribute("aria-expanded", "false");
  }

  langBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = langMenu?.classList.contains("is-open");
    if (isOpen) {
      closeLang();
    } else {
      langMenu?.classList.add("is-open");
      langChevron?.classList.add("rotate-180");
      langBtn?.setAttribute("aria-expanded", "true");
    }
  });

  document.addEventListener("click", closeLang);

  // --- Theme toggle ---
  const themeToggle = document.getElementById("theme-toggle");

  function applyTheme(theme: string) {
    if (theme === "light") {
      document.documentElement.setAttribute("data-theme", "light");
      document.documentElement.classList.remove("dark");
    } else {
      document.documentElement.removeAttribute("data-theme");
      document.documentElement.classList.add("dark");
    }
  }

  const saved = localStorage.getItem("theme") ?? "dark";
  applyTheme(saved);

  themeToggle?.addEventListener("click", () => {
    const current =
      document.documentElement.getAttribute("data-theme") === "light"
        ? "dark"
        : "light";
    applyTheme(current);
    localStorage.setItem("theme", current);
  });

  // --- Pagefind search ---
  const searchForm = document.getElementById("search-form");
  searchForm?.addEventListener("submit", (event) => event.preventDefault());

  const searchInput = document.getElementById(
    "navbar-search",
  ) as HTMLInputElement | null;
  const searchResults = document.getElementById("search-results");
  const searchResultsList = document.getElementById("search-results-list");
  const searchNoResults = document.getElementById("search-no-results");
  const searchDevWarning = document.getElementById("search-dev-warning");

  let pagefind: any = null;
  let pagefindLoading: Promise<void> | null = null;
  let debounceTimer: ReturnType<typeof setTimeout>;

  const closeResults = () => searchResults?.classList.add("hidden");
  const showResults = () => searchResults?.classList.remove("hidden");

  const isDark = () => document.documentElement.classList.contains("dark");

  if (import.meta.env.DEV) {
    searchInput?.addEventListener("focus", () => {
      searchNoResults?.classList.add("hidden");
      searchDevWarning?.classList.remove("hidden");
      showResults();
    });
  } else {
    // Lazy-load the index for the active site language on first interaction.
    const loadPagefind = () => {
      if (pagefindLoading) return pagefindLoading;
      const bundlePath =
        import.meta.env.BASE_URL.replace(/\/$/, "") + "/pagefind/pagefind.js";
      pagefindLoading = import(/* @vite-ignore */ bundlePath)
        .then((mod) => {
          pagefind = mod;
        })
        .catch(() => {
          console.warn("Pagefind could not be loaded.");
        });
      return pagefindLoading;
    };

    searchInput?.addEventListener("focus", loadPagefind);

    searchInput?.addEventListener("input", async (e) => {
      const term = (e.target as HTMLInputElement).value.trim();
      clearTimeout(debounceTimer);

      if (!term) {
        closeResults();
        return;
      }

      debounceTimer = setTimeout(async () => {
        await loadPagefind();
        if (!pagefind) return;

        try {
          const res = await pagefind.search(term);
          const top = res.results.slice(0, 7);

          if (searchResultsList) searchResultsList.innerHTML = "";

          if (top.length === 0) {
            searchNoResults?.classList.remove("hidden");
            showResults();
            return;
          }

          searchNoResults?.classList.add("hidden");

          const fragments = await Promise.all(top.map((r: any) => r.data()));

          fragments.forEach((fragment: any) => {
            const a = document.createElement("a");
            a.href = fragment.url;
            a.className = isDark()
              ? "block px-4 py-2.5 hover:bg-white/10 transition-colors border-b border-white/5 last:border-0"
              : "block px-4 py-2.5 hover:bg-teal-50 transition-colors border-b border-teal-100 last:border-0";
            a.innerHTML = isDark()
              ? `<div class="text-sm font-medium text-white truncate">${fragment.meta?.title ?? fragment.title}</div>
                 <div class="text-xs text-white/50 mt-0.5 line-clamp-1">${fragment.excerpt}</div>`
              : `<div class="text-sm font-medium text-teal-950 truncate">${fragment.meta?.title ?? fragment.title}</div>
                 <div class="text-xs text-teal-500 mt-0.5 line-clamp-1">${fragment.excerpt}</div>`;
            a.addEventListener("click", closeResults);
            searchResultsList?.appendChild(a);
          });

          showResults();
        } catch {
          // silently fail
        }
      }, 250);
    });

    searchInput?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeResults();
        searchInput.blur();
      } else if (e.key === "Enter") {
        const first = searchResultsList?.querySelector(
          "a",
        ) as HTMLAnchorElement | null;
        if (first) {
          window.location.href = first.href;
          closeResults();
        }
      }
    });
  }

  document.addEventListener("click", (e) => {
    if (!searchForm?.contains(e.target as Node)) {
      closeResults();
    }
  });

  document.addEventListener("astro:before-swap", () => {
    clearTimeout(debounceTimer);
    void pagefind?.destroy?.();
    pagefind = null;
    pagefindLoading = null;
    searchResultsList?.replaceChildren();
    closeResults();
  });
  }

  initNavbar();
  syncPersistentNavbarLocale();
  document.addEventListener("astro:page-load", initNavbar);
  document.addEventListener("astro:page-load", syncPersistentNavbarLocale);
</script>

<style>
  .lang-menu {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem) scale(0.96);
    transform-origin: top right;
    transition: opacity 160ms ease, transform 240ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 240ms;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .lang-menu.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-menu,
    .lang-menu.is-open {
      transition: none;
      transform: none;
    }
  }

  #search-results mark {
    background: transparent;
    color: rgb(52 211 153); /* emerald-400 */
    font-weight: 600;
  }
</style>