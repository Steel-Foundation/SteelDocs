---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import defaultSocialImage from "@/assets/sunset.webp";
import "../styles/global.css";
import ThemedPixelBlast from "@/components/homepage/ThemedPixelBlast";
import LogoCredit from "@/components/sections/LogoCredit.astro";

interface Props {
  title: string;
  description?: string;
  socialTitle?: string;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  pageType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  animatedBackground?: boolean;
}

const {
  title,
  description = "Documentation, downloads, implementation status, and development updates for SteelMC, a Minecraft server written in Rust.",
  socialTitle = title,
  socialImage,
  socialImageAlt,
  pageType = "website",
  publishedAt,
  updatedAt,
  author,
  animatedBackground = true,
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const resolvedSocialImage = socialImage ?? defaultSocialImage;
const resolvedSocialImageAlt = socialImageAlt ?? (socialImage
  ? undefined
  : "A sunset over a SteelMC-generated Minecraft world.");
const renderedSocialImage = await getImage({
  src: resolvedSocialImage,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpg",
  quality: 85,
});
const socialImageUrl = new URL(renderedSocialImage.src, siteUrl);
---

<html lang={Astro.currentLocale} class="scroll-smooth">
  <head>
    <title>{title}</title>
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="SteelMC" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {
      socialImageUrl && (
        <>
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {resolvedSocialImageAlt && (
            <meta property="og:image:alt" content={resolvedSocialImageAlt} />
          )}
        </>
      )
    }
    {
      pageType === "article" && publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {
      pageType === "article" && updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {
      resolvedSocialImageAlt && (
        <meta name="twitter:image:alt" content={resolvedSocialImageAlt} />
      )
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    <script is:inline>
      // Apply theme before paint to avoid flash
      if ((localStorage.getItem("theme") ?? "dark") === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="bg-teal-100 dark:bg-teal-950">
    {
      animatedBackground ? (
        <div class="fixed inset-0 w-full h-full -z-10">
          <ThemedPixelBlast
            client:only="react"
            variant="square"
            pixelSize={4}
            patternScale={2}
            patternDensity={1}
            pixelSizeJitter={0}
            enableRipples
            rippleSpeed={0.4}
            rippleThickness={0.12}
            rippleIntensityScale={1.5}
            liquid={false}
            liquidStrength={0.12}
            liquidRadius={1.2}
            liquidWobbleSpeed={5}
            speed={3}
            edgeFade={0.25}
            transparent
          />
        </div>
      ) : (
        <div
          class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(circle_at_15%_10%,rgba(16,185,129,0.16),transparent_35%),radial-gradient(circle_at_85%_35%,rgba(20,184,166,0.12),transparent_32%)] dark:bg-[radial-gradient(circle_at_15%_10%,rgba(16,185,129,0.12),transparent_35%),radial-gradient(circle_at_85%_35%,rgba(20,184,166,0.08),transparent_32%)]"
          aria-hidden="true"
        />
      )
    }
    <slot />
    <LogoCredit />
  </body>
</html>
